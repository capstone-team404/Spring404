ADMIN_EMAILS=admintest@gmail.com

# Facility collection (credentials are backend-only; never use VITE_ prefixes).
DATA_GO_KR_SERVICE_KEY=
KAKAO_REST_API_KEY=
FACILITY_REFRESH_DAYS=7
POLICE_COLLECTION_RADIUS_M=2000
# Empty streetlight settings use Seoul OA-22205 CSV (2023-12-21, limited coverage).
STREETLIGHT_CSV_URL=
STREETLIGHT_CSV_PATH=
STREETLIGHT_DATA_DATE=
# Security-light coverage must include the target area. Unset = uncollected, not zero.
SECURITY_LIGHT_CSV_URL=
SECURITY_LIGHT_CSV_PATH=
SECURITY_LIGHT_DATA_DATE=

# Use demo only for an explicitly marked test deployment. Naver is the default.
AUTH_VERIFICATION_MODE=naver
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
